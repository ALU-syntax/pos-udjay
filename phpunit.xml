<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <!--
            PENTING: jangan hapus baris DB_* di bawah.

            Test WAJIB memakai database terpisah, bukan database utama dari .env.
            Tanpa override ini, test yang memakai RefreshDatabase / DatabaseMigrations
            akan menjalankan migrate:fresh pada DATABASE ASLI sehingga seluruh data
            terhapus setiap kali `php artisan test` dijalankan.

            Buat database test sekali dengan:
                mysql -u root -p -e "CREATE DATABASE pos_udjaya_testing;"

            Struktur MySQL dipakai (bukan SQLite) agar skema, index, dan perilaku
            kolom di test identik dengan produksi.
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="pos_udjaya_testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
